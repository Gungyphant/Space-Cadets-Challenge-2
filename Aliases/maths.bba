    "code": "#> _fmv_copy = first_multiplicand_variable;\n    clear _fmv_copy;\n    #> _fmv_copy += first_multiplicand_variable;\n        clear _first_addend_holder;\n        \n        while first_multiplicand_variable not 0 do;\n            incr _fmv_copy;\n            incr _first_addend_holder;\n            decr first_multiplicand_variable;\n        end;\n        \n        while _first_addend_holder not 0 do;\n            incr first_multiplicand_variable;\n            decr _first_addend_holder;\n        end;\n    #< done\n#< done\n#> _smv_copy = second_multiplicand_variable;\n    clear _smv_copy;\n    #> _smv_copy += second_multiplicand_variable;\n        clear _first_addend_holder;\n        \n        while second_multiplicand_variable not 0 do;\n            incr _smv_copy;\n            incr _first_addend_holder;\n            decr second_multiplicand_variable;\n        end;\n        \n        while _first_addend_holder not 0 do;\n            incr second_multiplicand_variable;\n            decr _first_addend_holder;\n        end;\n    #< done\n#< done\nclear result_variable;\nwhile _fmv_copy not 0 do;\n    #> result_variable += _smv_copy;\n        clear _first_addend_holder;\n        \n        while _smv_copy not 0 do;\n            incr result_variable;\n            incr _first_addend_holder;\n            decr _smv_copy;\n        end;\n        \n        while _first_addend_holder not 0 do;\n            incr _smv_copy;\n            decr _first_addend_holder;\n        end;\n    #< done\n    decr _fmv_copy;\nend;\n# Note: this is faster if first_multiplicand_variable is larger than second_multiplicand_variable"
