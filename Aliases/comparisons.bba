[
  {
    "signature": "{result_variable} = {first_variable} == {second_variable}",
    "code": "# Note: first_variable must be greater than second_variable or the program will crash\n#> _difference = first_variable - second_variable;\n    #> _difference = first_variable;\n        clear _difference;\n        #> _difference += first_variable;\n            clear _first_variable_holder;\n            \n            while first_variable not 0 do;\n                incr _difference;\n                incr _first_variable_holder;\n                decr first_variable;\n            end;\n            \n            while _first_variable_holder not 0 do;\n                incr first_variable;\n                decr _first_variable_holder;\n            end;\n        #< done _difference += first_variable;\n    #< done _difference = first_variable;\n    #> _difference -= second_variable;\n        clear _second_variable_holder;\n        \n        while second_variable not 0 do;\n            decr _difference;\n            incr _second_variable_holder;\n            decr second_variable;\n        end;\n        \n        while _second_variable_holder not 0 do;\n            incr second_variable;\n            decr _second_variable_holder;\n        end;\n    #< done _difference -= second_variable;\n#< done _difference = first_variable - second_variable;\nclear result_variable;\nincr result_variable;\nwhile _difference not 0 do;\n    clear result_variable;\n    clear _difference;\nend;\n\n# If first_variable == second_variable, result_variable = 1. Otherwise, result_variable = 0"
  }
