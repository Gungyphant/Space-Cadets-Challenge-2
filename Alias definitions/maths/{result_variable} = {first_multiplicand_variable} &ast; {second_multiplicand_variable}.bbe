using maths;

_fmv_copy = first_multiplicand_variable;
_smv_copy = second_multiplicand_variable;
clear result_variable;
while _fmv_copy not 0 do;
    result_variable += _smv_copy;
    decr _fmv_copy;
end;
# Note: this is faster if first_multiplicand_variable is larger than second_multiplicand_variable