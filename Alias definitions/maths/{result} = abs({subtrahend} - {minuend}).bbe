using variables;
using comparisons;

_s_subtrahend_copy = subtrahend;
_m_minuend_copy = minuend;

_s_subtrahend_copy_ne_zero = _s_subtrahend_copy != 0;
_m_minuend_copy_ne_zero = _m_minuend_copy != 0;
_neither_are_zero = _m_minuend_copy_ne_zero and _s_subtrahend_copy_ne_zero;
while _neither_are_zero not 0 do;
    decr _s_subtrahend_copy;
    decr _m_minuend_copy;

    _s_subtrahend_copy_ne_zero = _s_subtrahend_copy != 0;
    _m_minuend_copy_ne_zero = _m_minuend_copy != 0;
    _neither_are_zero = _m_minuend_copy_ne_zero and _s_subtrahend_copy_ne_zero;
end;


clear result;

while _m_minuend_copy_ne_zero not 0 do;
    # _m_minuend_copy_ne_zero is True, so minuend must be the larger
    result = _m_minuend_copy;
    clear _m_minuend_copy_ne_zero;
end;

while _s_subtrahend_copy_ne_zero not 0 do;
    # _s_subtrahend_copy_ne_zero is True, so subtrahend must be the larger
    result = _s_subtrahend_copy;
    clear _s_subtrahend_copy_ne_zero;
end;
